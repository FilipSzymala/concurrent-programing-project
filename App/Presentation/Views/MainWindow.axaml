<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Presentation.ViewModels"
        xmlns:views="using:Presentation.Views"
        xmlns:models="using:Presentation.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="800"
        x:Class="Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Concurrent Programming — Stage 2"
        Width="1240"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        Background="#0D1117">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1F6FEB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#388BFD" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1158C7" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C333C" />
        </Style>
        <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="TextElement.Foreground" Value="#5C6473" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="CaretBrush" Value="#58A6FF" />
            <Setter Property="SelectionBrush" Value="#1F6FEB" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#58A6FF" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Background="#161B22" Padding="28,18"
                BorderThickness="0,0,0,1" BorderBrush="#30363D">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="6" Height="36" Background="#1F6FEB" CornerRadius="3" />
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Concurrent Programming"
                               Foreground="#F0F6FC" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Stage 2 — Elastic ball collisions"
                               Foreground="#8B949E" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24"
              ColumnDefinitions="*, 18, 320"
              RowDefinitions="Auto, 18, *">

            <Border Grid.Row="0" Grid.Column="0"
                    Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                    CornerRadius="10" Padding="22">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Simulation" Foreground="#8B949E"
                                       FontSize="12" FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <Button Classes="secondary"
                                    Content="{Binding Board.SimulationToggleLabel}"
                                    Command="{Binding Board.ToggleMoveSimulationCommand}" />
                        </StackPanel>

                        <Rectangle Width="1" Height="22" Fill="#30363D" />

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Count" Foreground="#8B949E"
                                       FontSize="12" FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <TextBox Width="72" Text="{Binding Board.BallsCountText}" />
                            <Button Classes="primary" Content="Generate"
                                    Command="{Binding Board.StartCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#21262D" />

                    <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Balls" Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Board.BallsCount}" Foreground="#F0F6FC"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Avg speed" Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Board.AverageSpeed, StringFormat=\{0:F2\}}"
                                       Foreground="#F0F6FC" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Energy" Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Board.TotalKineticEnergy, StringFormat=\{0:F0\}}"
                                       Foreground="#F0F6FC" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Momentum" Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Board.TotalMomentum, StringFormat=\{0:F2\}}"
                                       Foreground="#F0F6FC" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Tick" Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Board.PhysicsTickMs, StringFormat=\{0:F2\} ms}"
                                       Foreground="#F0F6FC" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Load" Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Board.PhysicsLoadPercent, StringFormat=\{0:F0\}%}"
                                       Foreground="{Binding Board.LoadBrush}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="FPS" Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Board.ActualFps, StringFormat=\{0:F0\}}"
                                       Foreground="{Binding Board.FpsBrush}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Board.StatusMessage}"
                                   Foreground="#D29922" FontSize="13"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0"
                    Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                    CornerRadius="10" Padding="18">
                <views:Board DataContext="{Binding Board}" />
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                    Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                    CornerRadius="10" Padding="22">
                <Grid RowDefinitions="Auto, Auto, *">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Ball details" Foreground="#F0F6FC"
                                   FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Selected ball state in real time"
                                   Foreground="#8B949E" FontSize="11" />
                    </StackPanel>

                    <Rectangle Grid.Row="1" Height="1" Fill="#21262D" Margin="0,18,0,18" />

                    <Panel Grid.Row="2">
                        <ContentControl Content="{Binding Board.SelectedBallDetails}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="models:BallListItem">
                                    <StackPanel Spacing="18">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="ID" Foreground="#8B949E" FontSize="11" />
                                            <TextBlock Text="{Binding Id}" Foreground="#F0F6FC"
                                                       FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="#21262D" />

                                        <Grid ColumnDefinitions="*, *"
                                              RowDefinitions="Auto, Auto"
                                              RowSpacing="14" ColumnSpacing="14">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Position X" Foreground="#8B949E" FontSize="11" />
                                                <TextBlock Text="{Binding X, StringFormat=\{0:F2\}}"
                                                           Foreground="#F0F6FC" FontSize="14" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Position Y" Foreground="#8B949E" FontSize="11" />
                                                <TextBlock Text="{Binding Y, StringFormat=\{0:F2\}}"
                                                           Foreground="#F0F6FC" FontSize="14" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Velocity X" Foreground="#8B949E" FontSize="11" />
                                                <TextBlock Text="{Binding VelocityX, StringFormat=\{0:F2\}}"
                                                           Foreground="#F0F6FC" FontSize="14" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Velocity Y" Foreground="#8B949E" FontSize="11" />
                                                <TextBlock Text="{Binding VelocityY, StringFormat=\{0:F2\}}"
                                                           Foreground="#F0F6FC" FontSize="14" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#21262D" />

                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Diameter" Foreground="#8B949E" FontSize="11" />
                                                <TextBlock Text="{Binding Diameter, StringFormat=\{0:F2\}}"
                                                           Foreground="#F0F6FC" FontSize="14" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Mass" Foreground="#8B949E" FontSize="11" />
                                                <TextBlock Text="{Binding Mass, StringFormat=\{0:F2\}}"
                                                           Foreground="#F0F6FC" FontSize="14" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#21262D" />

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Color" Foreground="#8B949E" FontSize="11" />
                                            <Border Height="32" CornerRadius="6"
                                                    BorderBrush="#30363D" BorderThickness="1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color}" />
                                                </Border.Background>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                    IsVisible="{Binding Board.SelectedBallDetails, Converter={x:Static ObjectConverters.IsNull}}">
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                    HorizontalAlignment="Center" />
                            <TextBlock Text="No ball selected"
                                       Foreground="#C9D1D9" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Click any ball on the board to inspect"
                                       Foreground="#6E7681" FontSize="11"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220" />
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
